# CalorieMate Environment Configuration
# Copy this file to .env and customize for your environment

# Security
SECRET_KEY=your-super-secret-key-change-in-production
WTF_CSRF_SECRET_KEY=another-secret-key-for-csrf

# Database Configuration
DATABASE_URI=mysql+pymysql://root:@localhost:3306/caloriemate

# External API Keys (Optional)
NUTRITION_API_KEY=your-nutrition-api-key-here
BARCODE_API_KEY=your-barcode-api-key-here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB max file size
UPLOAD_FOLDER=uploads

# Email Configuration (for future use)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# Admin Configuration
ADMIN_EMAIL=admin@caloriemate.com