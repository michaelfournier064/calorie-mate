# NOTE: Do not commit real secrets or production credentials to this file. Use only for local testing.

# CalorieMate Docker Environment Configuration

# Essential Configuration
SECRET_KEY=dev-key-change-in-production-docker
DATABASE_URL=mysql+pymysql://caloriemate_user:caloriemate_pass@db:3306/caloriemate

# Optional External API Keys
NUTRITION_API_KEY=your-nutrition-api-key
BARCODE_API_KEY=your-barcode-api-key

# Docker-specific Environment Variables
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1