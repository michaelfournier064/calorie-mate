# NOTE: Do not commit real secrets or production credentials to this file. Use only for local testing.

# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-key-change-in-production-docker

# Database Configuration (MySQL) - Raw SQL Implementation
DB_HOST=db
DB_PORT=3306
DB_USER=caloriemate_user
DB_PASSWORD=caloriemate_pass
DB_NAME=caloriemate

# Raw SQL Database Configuration (replaces SQLAlchemy DATABASE_URI)
DATABASE_URI=mysql+pymysql://caloriemate_user:caloriemate_pass@db:3306/caloriemate

# Application Settings
MAX_CONTENT_LENGTH=16777216
WTF_CSRF_TIME_LIMIT=3600

# Email Configuration (Optional - for future implementation)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@caloriemate.local

# External API Keys (Placeholder - replace with real keys)
NUTRITION_API_KEY=your-nutrition-api-key
BARCODE_API_KEY=your-barcode-api-key

# Security & Performance
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Application Environment
ENV=development
PORT=5000